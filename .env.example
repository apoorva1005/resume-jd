# Copy to .env and fill in. Never commit the real .env.

# --- MongoDB Atlas ---
# From Atlas: Database > Connect > Drivers. Remember to URL-encode the password.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=resume_matcher

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-you-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Models (downloaded from HuggingFace on first run, cached after) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIM=384

# --- Explanation LLM (free tiers) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Gemini fallback: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Retrained re-ranker ---
RANKER_PATH=models/ranker.joblib

# --- Frontend ---
API_BASE_URL=http://localhost:8000

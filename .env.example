MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=resume_matcher #db name


JWT_SECRET=change-me-before-you-deploy# to signin jwt tokens
JWT_ALGORITHM=HS256 #same secret key to create and verify the signature
ACCESS_TOKEN_EXPIRE_MINUTES=1440 #24 hours


EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2#for semantic search
EMBEDDING_DIM=384


CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2 #omparing two pieces of text


CHROMA_MODE=persistent #not temporary storage
CHROMA_PATH=./chroma_data
CHROMA_HOST=chroma #container name for docker
CHROMA_PORT=8000
CHROMA_SSL=false #not using HTTPS/SSL

#ChromaDB collections
CHROMA_RESUME_COLLECTION=resume_embeddings
CHROMA_JD_COLLECTION=jd_embeddings

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant


GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


RANKER_PATH=models/ranker.joblib #locally saved machine-learning ranking model

API_BASE_URL=http://localhost:8000
